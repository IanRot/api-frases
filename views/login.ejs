<%- include('partials/header') %>

<div class="auth-container glass">
    <h2 style="text-align: center; margin-bottom: 2rem;">Iniciar Sesión</h2>
    <div id="login-alert" class="alert"></div>
    <form id="login-form">
        <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <input type="email" id="email" name="email" required placeholder="tu@email.com">
        </div>
        <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" required placeholder="••••••••">
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Entrar</button>
    </form>
    <p style="text-align: center; margin-top: 1.5rem; color: var(--text-secondary); font-size: 0.9rem;">
        ¿No tienes cuenta? <a href="/register" style="color: var(--primary); text-decoration: none;">Regístrate aquí</a>
    </p>
</div>

<%- include('partials/footer') %>
