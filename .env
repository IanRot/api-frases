PORT=3000

# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:password@host:puerto/nombre_db
# Ejemplos:
#   Local:     postgresql://postgres:1234@localhost:5432/frases_db
#   Railway:   postgresql://postgres:xxxx@containers-us-west-x.railway.app:6543/railway
#   Supabase:  postgresql://postgres:xxxx@db.xxxx.supabase.co:5432/postgres
#   Render:    postgresql://user:xxxx@dpg-xxxx.oregon-postgres.render.com/frases_db
DATABASE_URL=postgresql://neondb_owner:npg_CJc08qFhELij@ep-broad-queen-apihilvf-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require

# Activar SSL para servicios en la nube (Railway, Supabase, Render, Neon...)
DB_SSL=true

